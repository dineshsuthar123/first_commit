{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "StateProof single-host runner and private evidence bucket. Public interface is read-only.",
  "Parameters": {
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "SubnetId": {"Type": "AWS::EC2::Subnet::Id", "Description": "Public subnet with outbound internet routing"},
    "AmiId": {"Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>", "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"},
    "ApprovedBudgetUSD": {"Type": "Number", "MinValue": 1, "Description": "Recorded authorization ceiling; this parameter does not enforce a billing cap"}
  },
  "Resources": {
    "Evidence": {
      "Type": "AWS::S3::Bucket", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "LifecycleConfiguration": {"Rules": [{"Id": "ExpireDemoEvidence", "Status": "Enabled", "ExpirationInDays": 14, "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 1}}]}
      }
    },
    "EvidencePolicy": {"Type": "AWS::S3::BucketPolicy", "Properties": {"Bucket": {"Ref": "Evidence"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["Evidence", "Arn"]}, {"Fn::Sub": "${Evidence.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}}},
    "RunnerRole": {"Type": "AWS::IAM::Role", "Properties": {
      "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ec2.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
      "ManagedPolicyArns": [{"Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"}],
      "Policies": [{"PolicyName": "EvidenceAndSource", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
        {"Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": {"Fn::Sub": "${Evidence.Arn}/evidence/*"}},
        {"Effect": "Allow", "Action": ["s3:GetObject"], "Resource": {"Fn::Sub": "${Evidence.Arn}/sources/*"}}
      ]}}]
    }},
    "Profile": {"Type": "AWS::IAM::InstanceProfile", "Properties": {"Roles": [{"Ref": "RunnerRole"}]}},
    "SecurityGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {
      "GroupDescription": "Read-only HTTP console; no SSH, database or provider ingress", "VpcId": {"Ref": "VpcId"},
      "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0"}]
    }},
    "Runner": {"Type": "AWS::EC2::Instance", "Properties": {
      "ImageId": {"Ref": "AmiId"}, "InstanceType": "t3.medium", "IamInstanceProfile": {"Ref": "Profile"},
      "CreditSpecification": {"CPUCredits": "standard"},
      "MetadataOptions": {"HttpTokens": "required", "HttpPutResponseHopLimit": 2, "HttpEndpoint": "enabled"},
      "NetworkInterfaces": [{"DeviceIndex": "0", "AssociatePublicIpAddress": true, "SubnetId": {"Ref": "SubnetId"}, "GroupSet": [{"Ref": "SecurityGroup"}]}],
      "BlockDeviceMappings": [{"DeviceName": "/dev/xvda", "Ebs": {"VolumeType": "gp3", "VolumeSize": 20, "Encrypted": true, "DeleteOnTermination": true}}],
      "Tags": [{"Key": "Name", "Value": "StateProof"}, {"Key": "ApprovedBudgetUSD", "Value": {"Ref": "ApprovedBudgetUSD"}}],
      "UserData": {"Fn::Base64": "BOOTSTRAP_REPLACED_BY_MANAGE_PY"}
    }}
  },
  "Outputs": {
    "InstanceId": {"Value": {"Ref": "Runner"}}, "EvidenceBucket": {"Value": {"Ref": "Evidence"}},
    "ConsoleUrl": {"Value": {"Fn::Sub": "http://${Runner.PublicIp}"}}
  }
}
